# 复制为 .env 并填入真实密钥
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/storyforge
REDIS_URL=redis://redis:6379/0
JWT_SECRET_KEY=change-me-to-a-random-string
JWT_EXPIRE_HOURS=24

# ---------- LLM ----------
LLM_API_KEY=sk-xxx
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-v4-flash
# Docker 容器内用 Docker bridge 网关 IP；本机请改为 127.0.0.1
# LLM_PROXY=http://172.18.240.1:7897

# ---------- SearXNG ----------
# 必填!docker compose 未设置时会拒绝启动(见 docker-compose.yml 的 :? 校验)。
# 用随机值,如 openssl rand -hex 32
SEARXNG_SECRET_KEY=change-me-to-a-random-string

# ---------- Cookie / MCP 安全 ----------
# 仅当后端部署在 TLS 终止代理之后才设为 true(否则浏览器会拒绝 http 下的 Secure cookie)
# COOKIE_SECURE=false
# 仅当 MCP 客户端必须用 ?token= 连接时才设为 true(JWT 出现在 URL 中会泄漏进日志;
# 默认应使用 Authorization: Bearer)
# MCP_SSE_QUERY_TOKEN_ALLOWED=false

# ---------- Embedding (可选) ----------
# 不配则自动用 PostgreSQL 全文搜索
# EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
# EMBEDDING_MODEL=BAAI/bge-m3
# EMBEDDING_API_KEY=sk-xxx

# ---------- 搜索 ----------
# SearXNG 地址 (Docker Compose 内部网络使用服务名)
# SEARXNG_URL=http://searxng:8080
# 搜索结果数量上限
# SEARCH_MAX_RESULTS=10
# 是否启用 DuckDuckGo 回退 (SearXNG 不可用时)
# SEARCH_ENABLE_DDG_FALLBACK=true
# SerpAPI key (可选升级，配置后优先于 SearXNG)
# SERPAPI_API_KEY=

# ---------- 网页抓取 ----------
# 单次抓取最大字符数
# WEB_FETCH_MAX_CHARS=50000
# 抓取超时秒数
# WEB_FETCH_TIMEOUT=15

